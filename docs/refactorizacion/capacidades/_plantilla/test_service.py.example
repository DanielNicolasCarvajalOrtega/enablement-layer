# --------------------------------------------------------------------------- #
# Errores de dominio
# --------------------------------------------------------------------------- #


def test_sin_datos_es_nodata_y_no_unavailable():
    # Una tabla vacía con la query exitosa es NO_DATA (404), no UNAVAILABLE (503).
    # Confundir los dos le miente al agente sobre si tiene que reintentar (R8).
    with pytest.raises(NotFoundError) as exc:
        _svc(rows=[]).consultar_todo(date(2025, 5, 12))
    assert exc.value.error_code == "NO_DATA"


def test_fecha_invalida_es_invalid_argument():
    with pytest.raises(ValidationError) as exc:
        _svc().consultar_todo("banana")
    assert exc.value.error_code == "INVALID_ARGUMENT"
    # El mensaje nombra el campo que falló, no una lista fija de todos los campos
    # de la firma (ver H1 de la plantilla).
    assert "fecha" in exc.value.message


# --------------------------------------------------------------------------- #
# Comportamiento, no resultado
# --------------------------------------------------------------------------- #


def test_una_sola_consulta_al_repo():
    repo = FakeRepo(rows=[TodoRow("ALGO", 1, Decimal("1.00"))])
    TodoService(repo).consultar_todo(date(2025, 5, 12))
    assert repo.llamadas == 1


def test_el_service_no_acepta_argumentos_de_mas():
    # Guarda de contrato: si alguien agrega un filtro, esta prueba falla y obliga a
    # revisar la ficha y el catálogo antes de publicar un alcance que la fuente
    # normativa no autoriza.
    params = inspect.signature(TodoService.consultar_todo).parameters
    assert [p for p in params if p != "self"] == ["fecha"]   # TODO: [] si no acepta fecha


def test_el_contrato_de_entrada_rechaza_argumentos_no_declarados():
    # El schema MCP sale de la firma de la tool, no del modelo; el modelo fija que
    # un argumento extra es un error explícito y no algo que se ignora en silencio.
    with pytest.raises(PydanticValidationError):
        ConsultarTodoInput(ciudad="SANTIAGO")   # TODO: campo que no existe
    # TODO: si la entrada es vacía, además:
    # assert ConsultarTodoInput().model_dump() == {}


