import inspect
from datetime import date
from decimal import Decimal

import pytest
from pydantic import ValidationError as PydanticValidationError

from application.<dominio>.models import ConsultarTodoInput
from application.<dominio>.ports import TodoPort, TodoRow
from application.<dominio>.service import TodoService
from application.errors import NotFoundError, ValidationError


class FakeRepo(TodoPort):
    """Implementa el puerto con filas fijas y cuenta las llamadas."""

    def __init__(self, rows=None):
        self.rows = rows or []
        self.llamadas = 0

    def consultar_todo(self, fecha) -> list[TodoRow]:
        self.llamadas += 1
        return self.rows


def _svc(**kwargs) -> TodoService:
    return TodoService(FakeRepo(**kwargs))


# --------------------------------------------------------------------------- #
# Mapeo, orden y totales
# --------------------------------------------------------------------------- #


def test_mapea_filas_y_calcula_los_totales():
    svc = _svc(rows=[TodoRow("ALGO", 3, Decimal("10.50")), TodoRow("OTRO", 1, Decimal("2.25"))])
    out = svc.consultar_todo(date(2025, 5, 12))

    assert [i.campo for i in out.items] == ["ALGO", "OTRO"]
    assert out.total_cantidad == 4
    assert out.total_monto == Decimal("12.75")
    # Los totales son de la capa (R9): se suman acá, no se le piden al agente.
    assert out.total_monto == sum(i.monto for i in out.items)


